# Copy to .env and fill in. NEVER commit .env or db/*.db
DATABASE_URL=file:./db/custom.db

# Session signing + websocket room tokens. Generate: openssl rand -hex 32
SESSION_SECRET=

# Shared secret between the Next.js API and the queue mini-service (set the SAME value for both processes).
# Generate: openssl rand -hex 32
BROADCAST_SECRET=

# Platform super admin (used by `pnpm seed`; password >= 10 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public origin (used in SMS live-queue links). Use https:// in production → enables Secure cookies.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# COOKIE_SECURE=true

# Only if the site is served from a different origin than the websocket gateway
# ALLOWED_ORIGIN=

# sms.ir credentials (leave empty to keep SMS in the outbox only)
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=

# optional notification webhook
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
